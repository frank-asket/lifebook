{
  "name": "lifebook",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:api": "pnpm --filter @lifebook/api start:dev",
    "dev:web": "pnpm --filter @lifebook/web dev",
    "dev:marketing": "pnpm --filter @lifebook/marketing dev",
    "db:generate": "pnpm --filter @lifebook/api prisma:generate",
    "db:migrate": "pnpm --filter @lifebook/api prisma:migrate",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  },
  "dependencies": {
    "dotenv": "^18.0.7"
  },
  "version": "0.3.1.0",
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.23",
      "@nestjs/swagger>js-yaml": "5.4.1"
    },
    "packageExtensions": {
      "next@15": {
        "peerDependencies": {
          "@types/react": "^19.3.0"
        }
      },
      "expo-router@4": {
        "dependencies": {
          "query-string": "^7.1.3",
          "escape-string-regexp": "^4.0.0",
          "fast-deep-equal": "^3.1.3",
          "nanoid": "^3.3.7",
          "use-latest-callback": "^0.2.1",
          "expo-font": "~13.0.4"
        }
      }
    }
  }
}
