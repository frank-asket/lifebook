// ============================================================
// LIFEBOOK DATABASE SCHEMA
// Sprint 1 + Sprint 2
// Prisma ORM 5.22.0
// PostgreSQL / Supabase
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum FaithJourney {
  EXPLORING
  NEW_BELIEVER
  GROWING_BELIEVER
  DISCIPLESHIP
  MINISTRY_PREPARATION
  SERVING_IN_MINISTRY
}

enum PlatformRole {
  MEMBER
  CREATOR
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// USER
// ============================================================

model User {
  bibleReadingHistory BibleReadingHistory[]
  bibleReadingEnrollments BibleReadingPlanEnrollment[]
  id          String   @id @default(cuid())
  oidcSubject String   @unique
  email       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile      FaithProfile?
  prayers      PrayerEntry[]
  enrollments  Enrollment[]
  verification MinistryVerification?
  pastorProfile PastorProfile?
  careRequests  CareRequest[] @relation("CareMember")
  pastoralCases CareRequest[] @relation("CarePastor")
  role         PlatformRole          @default(MEMBER)

  // Sprint 2 relationships
  meditationReflections MeditationReflection[]
  meditationCompletions MeditationCompletion[]
  meditationBookmarks   MeditationBookmark[]
  dailyWordSessions     DailyWordSession[]

  // M3.5.3 — Bible Reader annotations
  bibleAnnotations      BibleAnnotation[]
  consentEvents         ConsentEvent[]
  suggestionDismissals  SuggestionDismissal[]
}

// ============================================================
// FAITH PROFILE
// ============================================================

model FaithProfile {
  userId String @id

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  journey  FaithJourney?
  language String        @default("en")

  learningGoals    String[]
  preferredFormats String[]

  personalizationConsent Boolean @default(false)
  aiProcessingConsent    Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// ============================================================
// DEVOTIONAL
// ============================================================

model Devotional {
  id                 String    @id @default(cuid())
  title              String
  scriptureReference String
  body               String
  locale             String    @default("en")
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
}

// ============================================================
// PRAYER SANCTUARY
// ============================================================

model PrayerEntry {
  id     String @id @default(cuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every text field holds an lbenc:v1 envelope bound to `prayer:<field>:<userId>:<id>`; never plaintext.
  ciphertext           String
  keyVersion           Int     @default(1)
  titleCiphertext      String?
  answerNoteCiphertext String?
  answeredAt           DateTime?
  meditationCiphertext String?
  meditationAt         DateTime?
  verseCiphertext      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, updatedAt])
}

// ============================================================
// LIVINGWORD — SERMONS
// ============================================================

model Sermon {
  id          String    @id @default(cuid())
  title       String
  description String?
  mediaKey    String
  locale      String @default("en")
  kind        String @default("audio")
  speaker     String?
  attribution String?
  transcript String?
  rightsReference String?
  approvedAt DateTime?
  approvedById String?
  publishedAt DateTime?
  creatorId   String
  createdAt   DateTime  @default(now())
}

// ============================================================
// DISCIPLESHIP — LEARNING PATHS
// ============================================================

model LearningPath {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String

  isPublished Boolean @default(false)

  lessons     Lesson[]
  enrollments Enrollment[]
}

// ============================================================
// DISCIPLESHIP — LESSONS
// ============================================================

model Lesson {
  id       String @id @default(cuid())
  pathId   String
  title    String
  position Int
  content  String

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  completions LearningLessonCompletion[]

  @@unique([pathId, position])
}

// ============================================================
// DISCIPLESHIP — ENROLLMENTS
// ============================================================

model Enrollment {
  id     String @id @default(cuid())
  userId String
  pathId String

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path LearningPath @relation(fields: [pathId], references: [id])

  startedAt DateTime @default(now())
  completions LearningLessonCompletion[]

  @@unique([userId, pathId])
}

// Completion is learning activity only, never a spiritual rank or ministry permission.
model LearningLessonCompletion {
  enrollmentId String
  lessonId String
  completedAt DateTime @default(now())
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([enrollmentId, lessonId])
  @@index([lessonId])
}

// ============================================================
// MINISTRY VERIFICATION
// ============================================================

model MinistryVerification {
  userId String @id

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        VerificationStatus @default(NOT_REQUESTED)
  reviewedAt    DateTime?
  reviewerNotes String?

  // Pastoral care pilot: who vouches for this minister and what they completed before activation.
  churchName                 String?
  ministryRole               String?
  country                    String?
  referenceName              String?
  referenceContactCiphertext String?
  trainingCourse             String?
  trainingCompletedAt        DateTime?
  codeOfConductSignedAt      DateTime?
  verifiedById               String?
  suspendedAt                DateTime?
  suspensionReason           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Public pastor profile. Shown only while the owner's verification is active (see PastorDirectoryService).
model PastorProfile {
  userId String @id

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug              String   @unique
  displayName       String
  bio               String   @db.Text
  languages         String[]
  acceptingRequests Boolean  @default(false)
  maxOpenRequests   Int      @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ============================================================
// SPRINT 2 — DAILY BIBLE MEDITATION
// ============================================================

model Meditation {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  scriptureReference String
  scriptureText      String?
  translation        String?

  explanation  String @db.Text
  questions    Json
  guidedPrayer String @db.Text

  locale      String    @default("en")
  publishDate DateTime? @db.Date
  isPublished Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reflections MeditationReflection[]
  completions MeditationCompletion[]
  bookmarks   MeditationBookmark[]

  @@index([locale, isPublished, publishDate])
}

// ============================================================
// SPRINT 2 — PRIVATE REFLECTIONS
// ============================================================

model MeditationReflection {
  id           String @id @default(cuid())
  userId       String
  meditationId String

  // Private content: encrypt at application level before production.
  text String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  meditation Meditation @relation(fields: [meditationId], references: [id], onDelete: Cascade)

  @@unique([userId, meditationId])
  @@index([userId])
}

// ============================================================
// SPRINT 2 — COMPLETION TRACKING
// ============================================================

model MeditationCompletion {
  id           String @id @default(cuid())
  userId       String
  meditationId String

  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  meditation Meditation @relation(fields: [meditationId], references: [id], onDelete: Cascade)

  @@unique([userId, meditationId])
  @@index([userId])
}

// ============================================================
// SPRINT 2 — BOOKMARKS
// ============================================================

model MeditationBookmark {
  id           String @id @default(cuid())
  userId       String
  meditationId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  meditation Meditation @relation(fields: [meditationId], references: [id], onDelete: Cascade)

  @@unique([userId, meditationId])
  @@index([userId])
}

// ============================================================
// BIBLE STUDY — CURATED LEARNING LIBRARY
// ============================================================

enum StudyMethod {
  THEMATIC
  CHARACTER
  BOOK
  SYSTEMATIC
}

enum StudyStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

model StudySeries {
  id          String            @id @default(cuid())
  slug        String
  locale      String            @default("en")
  title       String
  description String            @db.Text
  method      StudyMethod
  status      StudyStatus       @default(DRAFT)
  difficulty  String            @default("BEGINNER")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lessons     StudyLesson[]
  enrollments StudyEnrollment[]

  @@unique([slug, locale])
  @@index([method, status, locale])
}

model StudyLesson {
  id                  String                  @id @default(cuid())
  seriesId            String
  position            Int
  title               String
  scriptureReference  String
  introduction        String                  @db.Text
  historicalContext   String?                 @db.Text
  exegesis            String                  @db.Text
  theology            String?                 @db.Text
  reflectionQuestions Json
  guidedPrayer        String?                 @db.Text
  application         String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  series              StudySeries             @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  completions         StudyLessonCompletion[]

  @@unique([seriesId, position])
}

model StudyEnrollment {
  id        String      @id @default(cuid())
  userId    String
  seriesId  String
  startedAt DateTime    @default(now())
  series    StudySeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([userId])
}

model StudyLessonCompletion {
  id          String      @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime    @default(now())
  lesson      StudyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

// Milestone 3.4 — Daily Word progress (migration already applied)
enum DailyWordSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum DailyWordStep {
  UNDERSTAND
  MEDITATE
  REFLECT
  PRAY
  LIVE
}

model DailyWordSession {
  id String @id @default(cuid())
  userId String
  journeyDate DateTime @db.Date
  passageKey String
  status DailyWordSessionStatus @default(IN_PROGRESS)
  startedAt DateTime @default(now())
  completedAt DateTime?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps DailyWordStepProgress[]
  reflection DailyWordReflection?
  @@unique([userId, journeyDate])
  @@index([userId, status])
}

model DailyWordStepProgress {
  id String @id @default(cuid())
  sessionId String
  step DailyWordStep
  completedAt DateTime @default(now())
  session DailyWordSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, step])
}

model DailyWordReflection {
  id String @id @default(cuid())
  sessionId String @unique
  content String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session DailyWordSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ============================================================
// MILESTONE 3.5.3 — BIBLE ANNOTATIONS
// Bookmarks, highlights, and encrypted personal notes
// ============================================================

model BibleAnnotation {
  id             String   @id @default(cuid())
  userId         String
  locale         String
  passageId      String
  bookmarked     Boolean  @default(false)
  highlight      String?
  noteCiphertext String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, locale, passageId])
  @@index([userId, updatedAt])
}


// ============================================================
// M3.6 — READING HISTORY AND PLANS (ADDITIVE)
// ============================================================
model BibleReadingHistory {
  id String @id @default(cuid())
  userId String
  locale String
  chapterId String
  verse Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, locale, chapterId])
  @@index([userId, updatedAt])
}

model BibleReadingPlanEnrollment {
  id String @id @default(cuid())
  userId String
  planId String
  startedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions BibleReadingPlanDayCompletion[]
  @@unique([userId, planId])
  @@index([userId])
}

model BibleReadingPlanDayCompletion {
  id String @id @default(cuid())
  enrollmentId String
  day Int
  completedAt DateTime @default(now())
  enrollment BibleReadingPlanEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  @@unique([enrollmentId, day])
}

// ============================================================
// PASTORAL CARE — requests and private threads
// ============================================================

enum CareRequestStatus {
  OPEN
  CLAIMED
  CLOSED
}

// Text fields hold lbenc:v1 envelopes bound to the request; only the member and the claiming pastor can read them.
model CareRequest {
  id       String @id
  memberId String
  pastorId String?

  member User  @relation("CareMember", fields: [memberId], references: [id], onDelete: Cascade)
  pastor User? @relation("CarePastor", fields: [pastorId], references: [id], onDelete: SetNull)

  topic             String
  language          String
  contactPreference String
  nameCiphertext    String?
  phoneCiphertext   String?
  messageCiphertext String
  consentAt         DateTime
  status            CareRequestStatus @default(OPEN)
  claimedAt         DateTime?
  closedAt          DateTime?
  closedBy          String?
  deleteAfter       DateTime?
  memberReadAt      DateTime?
  pastorReadAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  messages CareMessage[]
  reports  CareReport[]

  @@index([status, language, createdAt])
  @@index([memberId, createdAt])
  @@index([pastorId, status])
}

model CareMessage {
  id         String   @id
  requestId  String
  senderRole String
  ciphertext String
  createdAt  DateTime @default(now())

  request CareRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

// One row per AI request, for daily limits and cost tracking. Never holds prayer text or output.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  outcome   String
  createdAt DateTime @default(now())

  @@index([userId, feature, createdAt])
}

enum CareReportStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// A concern raised from a conversation. The lead sees the conversation only if the reporter shared a copy.
// Kept when the member deletes the request (requestId becomes null) until its own deletion date.
model CareReport {
  id                   String           @id
  requestId            String?
  reporterId           String
  reporterRole         String
  subjectPastorId      String?
  category             String
  detailsCiphertext    String
  transcriptCiphertext String?
  status               CareReportStatus @default(OPEN)
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?
  handledById          String?
  resolutionCiphertext String?
  deleteAfter          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @default(now()) @updatedAt

  request CareRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

// Who did what in safeguarding, for accountability. Holds no conversation content.
model SafeguardingAction {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  pastorUserId String?
  reportId     String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// CONSENT HISTORY AND SUGGESTION DISMISSALS (20 October 2026)
// ============================================================

// Preference transitions recorded from this release onward; not a retroactive consent record.
// kind: "personalization" | "ai_processing". Deleted with the account.
model ConsentEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  granted   Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A suggestion the member chose to hide, so it stays hidden on every device.
model SuggestionDismissal {
  userId       String
  suggestionId String
  dismissedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, suggestionId])
}
