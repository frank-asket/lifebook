# Copy this file to .env and fill in your key to enable live AI generation.
# Without it, the server runs in dev-fallback mode automatically —
# useful for frontend development without burning API calls.
ANTHROPIC_API_KEY=

# Optional — defaults to 8787
PORT=8787

# --- Firebase Auth (optional) ---
# Leave all three blank to keep running in dev-fallback mode, where any
# client-supplied deviceId is trusted as-is. Fill all three in from a real
# Firebase service account to require verified login on every request.
# See backend/README.md, "Setting up real Firebase Auth".
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Security (recommended before any public deployment) ---
# Comma-separated list of allowed browser origins for CORS. Leave blank
# for local dev (allows everything) — native mobile requests are never
# affected by this either way, since they don't send an Origin header.
ALLOWED_ORIGINS=

# Rate limiting (per client IP, in-memory — see security/rateLimit.ts
# for the horizontal-scaling caveat).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_CHECKIN_MAX=10
