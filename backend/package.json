{
  "name": "lifebook-backend",
  "version": "0.1.0",
  "private": true,
  "description": "LifeBook agent pipeline + API — zero runtime dependencies by design (see README).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "dev:livingword": "tsx watch src/microservices/livingWord.ts",
    "start:livingword": "tsx src/microservices/livingWord.ts",
    "dev:voice": "tsx watch src/microservices/voice.ts",
    "start:voice": "tsx src/microservices/voice.ts",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "@supabase/supabase-js": "^2.116.0"
  }
}
