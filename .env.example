# Root `.env` is loaded by the Python API. Next.js reads `clients/web/.env.local`
# locally; set the same web values in the Vercel project environment settings.

ALLOWED_ORIGINS=
ANTHROPIC_API_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
EMAIL_FROM=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
GEMINI_API_KEY=
LIFEBOOK_API_URL=
LIFEBOOK_STORAGE_BACKEND=json
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SITE_URL=
RATE_LIMIT_CHECKIN_MAX=
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
RESEND_API_KEY=
SENDGRID_API_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Next.js Drizzle connection to Supabase Postgres. These are database connection
# values from Supabase, not API keys. Keep SQL_PASSWORD server-side.
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=