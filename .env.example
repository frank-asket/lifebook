DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres?sslmode=require"
CLERK_SECRET_KEY="sk_test_REPLACE"
CLERK_AUTHORIZED_PARTIES="http://localhost:3001,https://app.example.com"
CORS_ORIGINS="http://localhost:3001,https://app.example.com"
PORT=4000
# apps/web/.env.local: NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY, NEXT_PUBLIC_API_URL
# apps/mobile/.env: EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY, EXPO_PUBLIC_API_URL
# apps/marketing: no auth credentials required for public landing page
