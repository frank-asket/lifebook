# Backend only: never put secrets in NEXT_PUBLIC_ or EXPO_PUBLIC_ variables.
DATABASE_URL="postgresql://USER:@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres?sslmode=require"
CLERK_SECRET_KEY="sk_test_REPLACE"
CLERK_AUTHORIZED_PARTIES="http://localhost:3001,https://app.example.com"
CORS_ORIGINS="http://localhost:3001,https://app.example.com"
PORT=4000
# apps/web/.env.local: NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY, NEXT_PUBLIC_API_URL
# apps/mobile/.env: EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY, EXPO_PUBLIC_API_URL
# apps/marketing: no auth credentials required for public landing page

# Server-only Bible provider credentials and approved translation IDs
API_BIBLE_KEY="REPLACE_IN_SECRET_STORE"
API_BIBLE_EN_BIBLE_ID="de4e12af7f28f599-01"
API_BIBLE_FR_BIBLE_ID="a93a92589195411f-01"
# Preserve the existing note key. Never regenerate it on deployment.
BIBLE_NOTES_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARACTERS"
# JSON key ring; keep old entries when changing the active key. Store securely.
REFLECTION_ENCRYPTION_KEYS='{"primary":"REPLACE_WITH_64_HEX_CHARACTERS"}'
REFLECTION_ENCRYPTION_ACTIVE_KEY="primary"
